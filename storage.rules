rules_version = '2';

// Signed disciplinary documents and note attachments. Paths mirror the
// Firestore documents that own them (disciplinary/{action_id}/{filename},
// notes/{note_id}/{filename}) but Storage rules can't read that structure
// on their own — the firestore.exists()/get() calls below reach into
// Firestore to ask "does this person have a /users doc," the same
// authorization check firestore.rules uses for the records themselves.
//
// No public read, ever. These are personnel files.

service firebase.storage {
  match /b/{bucket}/o {

    function isHrUser() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isDavid() {
      return isHrUser() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'david';
    }

    // 25MB covers a scanned, signed multi-page PDF with room to spare.
    // Anything asking for more from this app is not a document upload.
    function isReasonableUpload() {
      return request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*');
    }

    // Same size cap, but also allows Word docs — for SOPs and other
    // reference material uploaded to Team training, which aren't
    // scanned/signed personnel records.
    function isReasonableDocUpload() {
      return request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    // Write-ups are David-only, same as the Firestore record they attach
    // to (disciplinary_actions).
    match /disciplinary/{actionId}/{fileName} {
      allow read: if isDavid();
      allow write: if isDavid() && isReasonableUpload();
      allow delete: if false; // superseded, not removed — keep the record
    }

    // Employee profile photos — display only, not a personnel record, so
    // (unlike disciplinary/notes/incidents above) a replaced photo can
    // actually be deleted instead of piling up superseded copies.
    match /employee_photos/{empId}/{fileName} {
      allow read: if isHrUser();
      allow write: if isHrUser() && isReasonableUpload();
      allow delete: if isHrUser();
    }

    match /notes/{noteId}/{fileName} {
      allow read: if isHrUser();
      allow write: if isHrUser() && isReasonableUpload();
      allow delete: if false;
    }

    match /incidents/{incidentId}/{fileName} {
      allow read: if isHrUser();
      allow write: if isHrUser() && isReasonableUpload();
      allow delete: if false; // superseded, not removed — keep the record
    }

    // Reference SOPs/documents in Team training — content, not a
    // personnel record, so unlike the above this can actually be deleted.
    match /training/{docId}/{fileName} {
      allow read: if isHrUser();
      allow write: if isHrUser() && isReasonableDocUpload();
      allow delete: if isHrUser();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
