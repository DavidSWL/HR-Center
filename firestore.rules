rules_version = '2';

// This app talks straight to Firestore from the browser — there is no
// server in between checking anything. Everything below is the entire
// security model. See docs/security-rules-explained.md for a line-by-line
// walkthrough in plain language.
//
// Default posture: deny everything. Every collection below opts back in
// explicitly. If a collection isn't listed, the catch-all at the bottom
// denies it.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers --------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // Any of the three HR staff — every one of them has a /users/{uid} doc.
    // This is the ONE thing that makes someone "in" the app at all.
    function isHrUser() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isDavid() {
      return isHrUser() && role() == 'david';
    }

    function isTanya() {
      return isHrUser() && role() == 'tanya';
    }

    function canDeleteTasks() {
      return isDavid() || isTanya();
    }

    // Field names that must never be written, under any spelling. This is
    // the enforcement of the CLAUDE.md exclusion list — a pay rate or an
    // SSN cannot be saved even by an honest mistake in the UI code, because
    // the rule rejects the write before it reaches the database.
    function hasForbiddenFields(data) {
      return data.keys().hasAny([
        // compensation
        'pay_rate', 'payRate', 'pay_type', 'payType', 'salary',
        'salary_band', 'salaryBand', 'bonus', 'comp_history', 'compHistory',
        'hourly_rate', 'hourlyRate', 'annual_salary', 'annualSalary',
        // final-pay figures on the termination form — printed only, per the
        // same rule as any other pay amount
        'final_wages_amount', 'finalWagesAmount', 'regular_hours',
        'regularHours', 'ot_hours', 'otHours', 'overtime_hours',
        'overtimeHours', 'vac_hours', 'vacHours', 'sick_pay', 'sickPay',
        'cmp_hours', 'cmpHours',
        // identity / financial
        'ssn', 'social_security', 'socialSecurity', 'ssn_last4', 'ssnLast4',
        'bank_account', 'bankAccount', 'bank_routing', 'bankRouting',
        'direct_deposit', 'directDeposit',
        // date of birth — birth month/day are fine, birth YEAR is not
        'dob', 'date_of_birth', 'dateOfBirth', 'birth_year', 'birthYear',
        // I-9 / work authorization — lives in a separate file by law
        'i9', 'I9', 'work_authorization', 'workAuthorization',
        // medical detail beyond Cal/OSHA Form 300 fields
        'diagnosis', 'physician_notes', 'physicianNotes',
        'workers_comp', 'workersComp', 'medical_restriction',
        'medicalRestriction',
        // ER narrative detail — stays in the Word investigation notes
        'witness_statement', 'witnessStatement',
        'complainant_identity', 'complainantIdentity'
      ]);
    }

    function isClean(data) {
      return !hasForbiddenFields(data);
    }

    function stamped(data) {
      return data.keys().hasAll(['entered_by']);
    }

    // ---- users ------------------------------------------------------------
    // Role assignment is how every other rule below decides who can do
    // what, so it is not something the app itself is allowed to change.
    // These three accounts are created and edited by hand (Firebase
    // Console or Admin SDK), never through the client.
    match /users/{uid} {
      allow read: if isHrUser();
      allow write: if false;
    }

    // ---- employees ----------------------------------------------------
    match /employees/{empId} {
      allow read: if isHrUser();
      allow create, update: if isHrUser() && isClean(request.resource.data);
      allow delete: if false; // terminate = status change, not a delete

      match /acknowledgments/{docId} {
        allow read: if isHrUser();
        allow create, update: if isHrUser() && isClean(request.resource.data);
        allow delete: if false;
      }
      match /reviews/{milestone} {
        allow read: if isHrUser();
        allow create, update: if isHrUser() && isClean(request.resource.data);
        allow delete: if false;
      }
      match /onboarding_docs/{docId} {
        allow read: if isHrUser();
        allow create, update: if isHrUser() && isClean(request.resource.data);
        allow delete: if false;
      }
      match /harassment_training/{docId} {
        allow read: if isHrUser();
        allow create, update: if isHrUser() && isClean(request.resource.data);
        allow delete: if false;
      }
    }

    // The New Hire board and Review queue run a collection-group query
    // (collectionGroup(db, 'reviews')) to pull every employee's review
    // rows in one read instead of one query per employee. Firestore
    // treats that as a different kind of request than reading a single
    // employee's own /reviews subcollection, and only grants it under a
    // rule declared with the {path=**} wildcard — the nested rule above
    // covers direct reads but not this. Without this block, that query
    // fails with a permissions error and silently blanks the whole page.
    match /{path=**}/reviews/{milestone} {
      allow read: if isHrUser();
    }
    // Same reason, same fix, for the harassment-training tracker's
    // collection-group read (one query for every employee's current
    // cycle instead of 110 individual reads).
    match /{path=**}/harassment_training/{docId} {
      allow read: if isHrUser();
    }

    // ---- policy documents -----------------------------------------------
    match /policy_documents/{docId} {
      allow read: if isHrUser();
      allow create, update: if isHrUser() && isClean(request.resource.data);
      allow delete: if false; // retire (set active:false), don't delete
    }

    // ---- attendance -------------------------------------------------------
    match /attendance/{occurrenceId} {
      allow read: if isHrUser();
      allow create: if isHrUser() && isClean(request.resource.data)
        && stamped(request.resource.data);
      allow update: if isHrUser() && isClean(request.resource.data);
      allow delete: if false;
    }

    // Applicant counts — one doc per date, tallies only. No applicant
    // names or identifying info are ever written here by design.
    match /applicant_counts/{dateId} {
      allow read: if isHrUser();
      allow create, update: if isHrUser() && isClean(request.resource.data);
      allow delete: if false;
    }

    // Named applicant tracker — pre-screening through orientation. No
    // resume/application file content, pay expectations, or SSN/DOB
    // fields belong here, same as everywhere else in this system.
    match /applicants/{applicantId} {
      allow read: if isHrUser();
      allow create: if isHrUser() && isClean(request.resource.data)
        && stamped(request.resource.data);
      allow update: if isHrUser() && isClean(request.resource.data);
      allow delete: if isHrUser();

      // Rejection reason — David's own note on why a candidate was
      // turned down, not visible to (or writable by) anyone else,
      // enforced here rather than just hidden in the UI.
      match /private/{docId} {
        allow read: if isDavid();
        allow create, update: if isDavid() && isClean(request.resource.data);
        allow delete: if false;
      }
    }

    // Open job requisitions — opened_date/filled_date only; time-to-fill
    // is computed from those on the Applicants tab and the Time to fill
    // report, never stored itself.
    match /open_jobs/{jobId} {
      allow read: if isHrUser();
      allow create: if isHrUser() && isClean(request.resource.data)
        && stamped(request.resource.data);
      allow update: if isHrUser() && isClean(request.resource.data);
      allow delete: if isHrUser();
    }

    // ---- discipline & notes ----------------------------------------------
    // Write-ups are David's alone — not just closing one out like ER
    // cases, but reading and filing them at all. Per his explicit
    // instruction, enforced here rather than just hidden in the nav.
    match /disciplinary_actions/{actionId} {
      allow read: if isDavid();
      allow create: if isDavid() && isClean(request.resource.data)
        && stamped(request.resource.data);
      allow update: if isDavid() && isClean(request.resource.data);
      allow delete: if false;
    }

    match /notes_to_file/{noteId} {
      allow read: if isHrUser();
      allow create: if isHrUser() && isClean(request.resource.data)
        && stamped(request.resource.data);
      allow update: if isHrUser() && isClean(request.resource.data);
      allow delete: if false;
    }

    // One doc per separation event, FK'd to emp_id — an employee can have
    // more than one over time (rehire), so this isn't a field on the
    // employees doc itself. Final-pay dollar figures are typed on the
    // generator, printed, and never included in the write — see
    // hasForbiddenFields above, which also rejects them if a future edit
    // accidentally includes one.
    match /terminations/{terminationId} {
      allow read: if isHrUser();
      allow create: if isHrUser() && isClean(request.resource.data)
        && stamped(request.resource.data);
      allow update: if isHrUser() && isClean(request.resource.data);
      allow delete: if false;
    }

    match /pips/{pipId} {
      allow read: if isHrUser();
      allow create: if isHrUser() && isClean(request.resource.data)
        && stamped(request.resource.data);
      allow update: if isHrUser() && isClean(request.resource.data);
      allow delete: if false;
    }

    // Self-tracked SHRM-CP study progress. Nothing sensitive, no
    // exclusion concerns — same open HR-staff access as everything else.
    match /shrm_progress/{uid} {
      allow read: if isHrUser();
      allow create, update: if isHrUser() && isClean(request.resource.data);
      allow delete: if false;
    }

    // ---- safety -------------------------------------------------------
    match /incidents/{incidentId} {
      allow read: if isHrUser();
      allow create: if isHrUser() && isClean(request.resource.data)
        && stamped(request.resource.data);
      allow update: if isHrUser() && isClean(request.resource.data);
      allow delete: if false;
    }

    match /safety_issues/{issueId} {
      allow read: if isHrUser();
      allow create, update: if isHrUser() && isClean(request.resource.data);
      allow delete: if false;
    }

    match /safety_meetings/{meetingId} {
      allow read: if isHrUser();
      allow create, update: if isHrUser() && isClean(request.resource.data);
      allow delete: if false;
    }

    // ---- employee relations ------------------------------------------
    // Cases are David's alone — reading and filing, not just closing.
    // Per his explicit instruction, enforced here rather than just
    // hidden in the nav.
    match /er_cases/{caseId} {
      allow read: if isDavid();
      // A case still can't be born already closed — that workflow rule
      // predates the access change and isn't affected by it.
      allow create: if isDavid() && isClean(request.resource.data)
        && request.resource.data.status != 'closed';
      allow update: if isDavid() && isClean(request.resource.data);
      allow delete: if false;

      match /interviews/{interviewId} {
        allow read: if isDavid();
        allow create, update: if isDavid() && isClean(request.resource.data);
        allow delete: if false;

        match /responses/{questionNo} {
          allow read: if isDavid();
          allow create, update: if isDavid() && isClean(request.resource.data);
          allow delete: if false;
        }
      }
    }

    // ---- tasks ----------------------------------------------------------
    match /tasks/{taskId} {
      allow read: if isHrUser();
      allow create, update: if isHrUser() && isClean(request.resource.data);
      // Tasks are append-only for everyone else — only David or Tanya can
      // remove one outright, per David's explicit instruction.
      allow delete: if canDeleteTasks();

      match /reassignments/{id} {
        allow read: if isHrUser();
        allow create: if isHrUser() && isClean(request.resource.data);
        allow update, delete: if false; // history — append only
      }
    }

    // ---- training ---------------------------------------------------------
    match /training_modules/{moduleId} {
      allow read: if isHrUser();
      allow create, update: if isHrUser() && isClean(request.resource.data);
      // Unlike everything else in this app, a course is content, not an
      // audit record — deleting an accidental duplicate shouldn't require
      // a Firebase Console trip. Staff completions live in a subcollection
      // and aren't touched by this.
      allow delete: if isHrUser();

      match /completions/{staffId} {
        allow read: if isHrUser();
        allow create, update: if isHrUser() && isClean(request.resource.data);
        allow delete: if false;
      }
    }

    // Reference SOPs/documents uploaded to Team training — metadata only,
    // the file itself lives in Storage. Also just content, so deletable.
    match /training_documents/{docId} {
      allow read: if isHrUser();
      allow create: if isHrUser() && isClean(request.resource.data)
        && stamped(request.resource.data);
      allow update: if isHrUser() && isClean(request.resource.data);
      allow delete: if isHrUser();
    }

    // ---- activity log ---------------------------------------------------
    // Every module writes here on completion — append only, never edited
    // or removed, so it stays a trustworthy record of who did what.
    match /activity/{activityId} {
      allow read: if isHrUser();
      allow create: if isHrUser() && isClean(request.resource.data)
        && stamped(request.resource.data);
      allow update, delete: if false;
    }

    // ---- iPad tracking --------------------------------------------------
    // Asset inventory, not an audit record — real deletes are fine here
    // (unlike incidents/terminations/etc.), same reasoning as
    // training_documents' SOPs.
    match /ipads/{ipadId} {
      allow read: if isHrUser();
      allow create: if isHrUser() && isClean(request.resource.data)
        && stamped(request.resource.data);
      allow update: if isHrUser() && isClean(request.resource.data);
      allow delete: if isHrUser();
    }

    // ---- settings (managed lists) -----------------------------------
    match /settings/{listName} {
      allow read: if isHrUser();
      allow create, update: if isHrUser() && isClean(request.resource.data);
      allow delete: if false;
    }

    // ---- default deny ---------------------------------------------------
    // Anything not explicitly matched above is closed. New collections
    // need a rule added here before the app can use them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
